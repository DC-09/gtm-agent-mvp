{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contatti dei lead qualificati",
  "description": "data/contacts.json, escluso dal repository: una voce per id di lead qualificato. Regole in docs/decisions.md (Contatti).",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["company_phone", "buyer_email", "buyer_mobile", "notes"],
    "properties": {
      "company_phone": {
        "description": "Telefono generico dell'azienda, pubblicato sul suo sito.",
        "oneOf": [
          {"type": "null"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "source_url", "accessed"],
            "properties": {
              "value": {"$ref": "#/$defs/phone"},
              "source_url": {"$ref": "#/$defs/url"},
              "accessed": {"$ref": "#/$defs/date"}
            }
          }
        ]
      },
      "buyer_email": {
        "description": "Email nominativa del buyer, trovata da Clay.",
        "oneOf": [
          {"type": "null"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "source", "retrieved", "note"],
            "properties": {
              "value": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$"},
              "source": {"const": "clay"},
              "retrieved": {"$ref": "#/$defs/date"},
              "note": {"type": ["string", "null"]}
            }
          }
        ]
      },
      "buyer_mobile": {
        "description": "Cellulare del buyer, trovato da Clay.",
        "oneOf": [
          {"type": "null"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "source", "retrieved"],
            "properties": {
              "value": {"$ref": "#/$defs/phone"},
              "source": {"const": "clay"},
              "retrieved": {"$ref": "#/$defs/date"}
            }
          }
        ]
      },
      "notes": {"type": ["string", "null"]}
    }
  },
  "$defs": {
    "phone": {"type": "string", "pattern": "^\\+39 [0-9 ]{6,16}$"},
    "url": {"type": "string", "pattern": "^https?://"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
